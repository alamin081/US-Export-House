# ---------------------------------------------------------------------------
# US Export House - environment template
#
# Copy to `.env.local` for local development:
#   cp .env.example .env.local
#
# Every variable below is validated by src/config/env.ts at startup. The app
# refuses to boot when a required value is missing or unsafe for APP_ENV.
# NEVER commit a file that contains real credentials.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# local | staging | production
APP_ENV=local
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=US Export House

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. NOTE: port 5432 is often already taken (a native
# PostgreSQL service, or another project container). Set POSTGRES_PORT in a
# local .env file and keep the port below in sync; on this machine the
# container is published on 55432.
DATABASE_URL=postgresql://use_admin:use_dev_password@localhost:5432/us_export_house?schema=public
# Managed providers (Neon/Supabase) expose a direct, non-pooled URL. Prisma
# migrations use it when set, because migrations must not run through a pooler.
# Leave empty locally.
DATABASE_URL_UNPOOLED=

# Neon (chosen for staging and production; Singapore = ap-southeast-1).
# Use the POOLED host for the app and the DIRECT host for migrations:
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.ap-southeast-1.aws.neon.tech/<db>?sslmode=require
#   DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.ap-southeast-1.aws.neon.tech/<db>?sslmode=require
# Set these in the hosting provider's encrypted environment settings, never in git.

# Integration tests run only against a database whose name ends in "_test".
# Defaults to DATABASE_URL with "_test" appended; override here if needed.
# TEST_DATABASE_URL=

# --- Auth (Phase 5) ---------------------------------------------------------
# Encrypts the staff session cookie. Generate: openssl rand -base64 32
# Use a different value in every environment. Rotating it signs everyone out.
AUTH_SECRET=replace-me-with-at-least-32-characters-long-secret

# Staff sessions end after this long without a request (minutes, default 480 = 8 h)
# and, however active, after the absolute lifetime (hours, default 168 = 7 days).
STAFF_SESSION_IDLE_TIMEOUT_MINUTES=480
STAFF_SESSION_MAX_AGE_HOURS=168

# One-time Super Admin bootstrap (npm run auth:bootstrap). Read ONLY by that
# script, never by the app. Set the password for a single run, then delete it.
# SUPER_ADMIN_EMAIL=admin@usexporthouse.com
# SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_PASSWORD=

# --- SMS / OTP (Phase 5) ----------------------------------------------------
# dev = OTP is printed to the server console only. Rejected when NODE_ENV=production.
SMS_PROVIDER=dev
SMS_API_KEY=
SMS_SENDER_ID=

# --- Payments (Phase 10) ----------------------------------------------------
# disabled | sandbox | live. COD needs no configuration.
PAYMENT_SSLCOMMERZ_MODE=disabled
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# --- Courier (Phase 11) -----------------------------------------------------
# mock | sandbox | live. `mock` never contacts Steadfast and is badged MOCK in admin.
COURIER_STEADFAST_MODE=mock
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=

# --- Image storage (Phase 6) ------------------------------------------------
# local = MOCK storage for development (files in public/uploads-dev/, badged
# "MOCK STORAGE" in the admin; refused when APP_ENV=production).
# cloudinary = real storage. The API secret is used only on the server to sign
# uploads; it never reaches the browser.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level folder in the Cloudinary account, e.g. ueh (prod) / ueh-staging.
CLOUDINARY_FOLDER=ueh

# --- Scheduled jobs ---------------------------------------------------------
# Shared secret for Vercel Cron (sent as "Authorization: Bearer <CRON_SECRET>"):
# expired session/throttle clean-up now; reservation release and courier
# polling later. Generate: openssl rand -base64 32. Cron routes answer 503 when empty.
CRON_SECRET=

# --- Docker Compose (local database container) -------------------------------
# These are read by docker compose, not by the app. Compose substitutes from a
# local `.env` file, so put POSTGRES_PORT there if 5432 is taken.
POSTGRES_USER=use_admin
POSTGRES_PASSWORD=use_dev_password
POSTGRES_DB=us_export_house
POSTGRES_PORT=5432
