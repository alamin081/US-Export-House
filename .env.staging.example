# ---------------------------------------------------------------------------
# US Export House - STAGING environment template (placeholders only)
#
# This file documents the variables for the Vercel project `ueh-staging`
# (Git branch: staging). It is NOT loaded by anything and must never hold real
# values. Enter the real values in:
#   Vercel -> ueh-staging -> Settings -> Environment Variables
#   (scope: Production only - in that project "Production" is the staging branch)
#
# Every variable is validated by src/config/env.ts at build and start. With
# APP_ENV=staging the app also refuses to start unless:
#   - APP_URL is https:// and NEXT_PUBLIC_APP_URL has the same origin;
#   - DATABASE_URL is the POOLED Neon host (contains "-pooler") and
#     DATABASE_URL_UNPOOLED is the DIRECT host, same database, both with
#     sslmode=require, neither pointing at localhost.
# NEVER commit real credentials. Never reuse Local or Production values.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=staging
APP_URL=https://<staging-domain>
NEXT_PUBLIC_APP_URL=https://<staging-domain>
NEXT_PUBLIC_SITE_NAME=US Export House (Staging)

# --- Database: Neon project `ueh-staging` (AWS ap-southeast-1) ---------------
# Pooled connection - used by the running app.
DATABASE_URL=postgresql://<role>:<password>@<endpoint-id>-pooler.ap-southeast-1.aws.neon.tech/<database>?sslmode=require
# Direct connection - used only by `prisma migrate deploy` (never through the pooler).
DATABASE_URL_UNPOOLED=postgresql://<role>:<password>@<endpoint-id>.ap-southeast-1.aws.neon.tech/<database>?sslmode=require

# --- Auth -------------------------------------------------------------------
# Unique to staging. Generate: openssl rand -base64 32
AUTH_SECRET=<generate-a-new-random-value-of-at-least-32-characters>
# Optional; these are the defaults (8 h idle, 7 days absolute).
STAFF_SESSION_IDLE_TIMEOUT_MINUTES=480
STAFF_SESSION_MAX_AGE_HOURS=168

# --- SMS / OTP --------------------------------------------------------------
# dev = OTP printed to the server log only (allowed on staging, refused in production).
SMS_PROVIDER=dev
SMS_API_KEY=
SMS_SENDER_ID=

# --- Payments ---------------------------------------------------------------
# disabled until Phase 10; then sandbox on staging. `live` is never used on staging.
PAYMENT_SSLCOMMERZ_MODE=disabled
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# --- Courier ----------------------------------------------------------------
# mock until Phase 11; then sandbox on staging.
COURIER_STEADFAST_MODE=mock
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=

# --- Image storage ------------------------------------------------------------
# Same Cloudinary account as local development. The folder is derived from
# APP_ENV: staging uploads go to ueh/staging (do not set CLOUDINARY_FOLDER; the
# default root "ueh" is intended). NOTE: one API key/secret can read and delete
# assets in EVERY folder (ueh/dev, ueh/staging, ueh/prod); folders separate
# files, not permissions.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# --- Scheduled jobs ---------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". Unique to staging.
# Generate: openssl rand -base64 32
CRON_SECRET=<generate-a-new-random-value>
