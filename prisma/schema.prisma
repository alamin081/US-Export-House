// =============================================================================
// US EXPORT HOUSE — DATABASE SCHEMA (Phase 4)
// =============================================================================
//
// PostgreSQL is the single source of truth for the storefront, the admin
// dashboard and the in-store till. The design follows the master spec:
//
//   * Money is ALWAYS an integer number of poisha (1 BDT = 100 poisha). There
//     is no Float or Decimal money column anywhere in this file.
//   * Bilingual content uses paired columns (`nameEn` required, `nameBn`
//     optional). English is mandatory, Bengali falls back to English. Two
//     languages are planned, so paired columns beat a translation table: they
//     keep queries, sorting and indexes simple. A third language would need a
//     migration — an accepted trade-off.
//   * Stock lives per location (`InventoryLevel`) and every change is appended
//     to the `InventoryMovement` ledger, which is never updated or deleted.
//   * Soft delete (`deletedAt`) on records the business must keep history for:
//     products, variants, categories, locations, coupons and staff.
//   * Order, payment, shipment and return history store snapshots of names,
//     SKUs and prices, so editing a product never rewrites past orders.
//
// Conventions: Prisma default identifier casing (quoted camelCase columns in
// Postgres), `cuid()` ids, `createdAt`/`updatedAt` on every table.
// =============================================================================

generator client {
  // Prisma 7 default generator. `output` is required and the client is no
  // longer written into node_modules, so it is generated under `src/` and
  // imported through the `@/` alias (see src/lib/db.ts).
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // `tsx` (used for the seed script) cannot resolve the generated client's
  // internal ".js" imports, so emit TypeScript import specifiers instead.
  importFileExtension = "ts"
}

datasource db {
  // The connection string lives in prisma.config.ts (Prisma 7 moved `url` out
  // of this block), which reads DATABASE_URL — Docker locally, Neon or
  // Supabase in the cloud. Both providers work without schema changes.
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum LocationType {
  BRANCH
  WAREHOUSE
}

enum UserKind {
  CUSTOMER
  STAFF
}

enum OtpPurpose {
  LOGIN
  PHONE_VERIFY
}

/// DRAFT -> PUBLISHED -> ARCHIVED. Only PUBLISHED products reach the storefront.
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Add a value here (ALTER TYPE ... ADD VALUE) to offer a new option kind.
enum OptionType {
  SIZE
  COLOUR
}

enum SizeChartUnit {
  INCH
  CM
}

/// Every reason stock can move. The ledger is append-only, so this list only
/// ever grows.
enum MovementType {
  PURCHASE_RECEIVE
  SALE_ONLINE
  SALE_STORE
  /// RESERVE and RELEASE change `reserved`, not `onHand`.
  RESERVE
  RELEASE
  TRANSFER_OUT
  TRANSFER_IN
  /// Deprecated (Phase 7): replaced by ADJUSTMENT_IN / ADJUSTMENT_OUT. Kept
  /// because enum values are never dropped; no row uses it.
  ADJUSTMENT
  RETURN
  DAMAGE
  OPENING
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_DISCREPANCY
  COUNT_CORRECTION
}

/// DRAFT -> (APPROVED, when `transfer.requireApproval` is on) -> DISPATCHED
/// -> RECEIVED. Only DRAFT and APPROVED transfers can be cancelled.
enum TransferStatus {
  DRAFT
  APPROVED
  DISPATCHED
  RECEIVED
  CANCELLED
}

/// IN_PROGRESS -> SUBMITTED -> APPLIED (or CANCELLED). DRAFT is unused
/// (a count snapshots when it starts) and stays only because enum values are
/// never dropped.
enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED
  APPLIED
  CANCELLED
}

/// Why a transfer line arrived short (or over).
enum TransferDiscrepancyReason {
  LOST
  DAMAGED
  WRONG_ITEM
  EXCESS
}

enum StockReceiptKind {
  /// First stock of a variant at a location (no earlier movement for it there).
  OPENING
  /// Goods from a supplier or factory.
  PURCHASE
}

enum StockReceiptSource {
  MANUAL
  CSV
}

enum SalesChannel {
  ONLINE
  STORE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  /// Deprecated (Phase 9): never used. A return after delivery leaves the order
  /// DELIVERED; the ReturnRequest and the payment status carry the return.
  RETURNED
  /// The courier could not deliver (refused, unreachable). The goods are on
  /// their way back; stock is untouched until they arrive.
  DELIVERY_FAILED
  /// A failed delivery is back and inspected; stock was returned or written off.
  RETURNED_TO_WAREHOUSE
}

/// Result of one confirmation call to the customer.
enum CallOutcome {
  CONFIRMED
  NO_ANSWER
  SWITCHED_OFF
  WRONG_NUMBER
  CALL_BACK_LATER
  CANCEL_REQUESTED
}

enum CancelReason {
  CUSTOMER_DECLINED
  FAKE_ORDER
  UNREACHABLE
  OUT_OF_STOCK
  OTHER
}

/// Tracked separately from OrderStatus on purpose: a COD order can be
/// DELIVERED and still UNPAID until the courier settles.
enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  COD
  SSLCOMMERZ
  BKASH
  NAGAD
  CASH
  CARD
  /// Value of items returned for an exchange, carried to the new order (Phase 9).
  EXCHANGE_CREDIT
}

enum PaymentAttemptStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED
}

enum RefundMethod {
  ORIGINAL
  BANK_TRANSFER
  /// Deprecated (Phase 9): use BKASH or NAGAD. Kept; no row uses it.
  MFS
  BKASH
  NAGAD
  /// Cash at the counter (no reference needed).
  CASH
}

/// PENDING = waiting for approval (above refund.approvalAbovePoisha).
enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
  /// Approval refused.
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  INSPECTED
  COMPLETED
  CANCELLED
}

enum ReturnItemCondition {
  UNUSED_WITH_TAGS
  USED
  DAMAGED
  WRONG_ITEM
}

/// ACCEPTED = back in stock; DAMAGED = came back unsellable (written off);
/// REJECTED = not accepted as a return (goes back to the customer).
enum InspectionResult {
  PENDING
  ACCEPTED
  REJECTED
  DAMAGED
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnReason {
  SIZE_MISMATCH
  DEFECTIVE
  WRONG_ITEM
  CHANGED_MIND
  OTHER
}

enum ReturnSource {
  CUSTOMER
  STAFF
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum CouponType {
  PERCENTAGE
  FIXED
  /// Delivery charge waived; `value` is 0.
  FREE_SHIPPING
}

/// Whether a coupon scope row includes or excludes its category/product.
enum CouponScopeMode {
  INCLUDE
  EXCLUDE
}

/// An administrative area below a district. Upazilas come from the dataset;
/// Dhaka Metropolitan thanas were added by us (docs/ADDRESS_DATA.md).
enum GeoAreaKind {
  UPAZILA
  METRO_THANA
}

enum CouponChannel {
  ONLINE
  STORE
  BOTH
}

enum CourierProviderType {
  STEADFAST
  PATHAO
  REDX
  /// The shop's own delivery person.
  MANUAL
  /// Any other courier; the name is in Shipment.courierName.
  OTHER
}

/// Integration mode, stored per shipment so a mock booking can never be
/// mistaken for a real one.
enum IntegrationMode {
  MOCK
  SANDBOX
  LIVE
  /// Typed in by staff (Phase 9): a real shipment, booked outside the app.
  MANUAL
}

enum ShipmentStatus {
  PENDING
  BOOKED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
  FAILED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum BannerPlacement {
  HOME_HERO
  HOME_PROMO
  CATEGORY_HEADER
}

enum HomeSectionType {
  HERO
  CATEGORY_GRID
  NEW_ARRIVALS
  BEST_SELLERS
  COLLECTION_GRID
  PROMO_BANNER
  BRAND_INTRO
  REVIEWS
  NEWSLETTER
}

enum MenuLocation {
  HEADER
  FOOTER
}

enum SettingValueType {
  STRING
  INT
  BOOLEAN
  JSON
}

// =============================================================================
// PEOPLE & ACCESS
// =============================================================================

/// Customers and staff share one table. Customers sign in with a phone number
/// and an SMS OTP; staff sign in with email and an Argon2id password hash.
model User {
  id   String   @id @default(cuid())
  kind UserKind @default(CUSTOMER)

  // --- customer identity -----------------------------------------------
  /// Stored in E.164 form: +8801XXXXXXXXX.
  phone           String?   @unique
  phoneVerifiedAt DateTime?

  // --- staff identity (also used by Auth.js) ---------------------------
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  /// Argon2 hash of the till PIN a manager types to allow a larger discount.
  posPinHash    String?
  name          String?
  image         String?

  /// Staff role. Customers have no role.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  isActive  Boolean   @default(true)
  lastLogin DateTime?
  /// Soft delete: staff and customer history must survive deactivation.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  addresses            Address[]
  carts                Cart[]
  orders               Order[]
  returnRequests       ReturnRequest[]
  locationAccess       StaffLocationAccess[]
  auditLogs            AuditLog[]
  movements            InventoryMovement[]
  transfersCreated     StockTransfer[]       @relation("TransferCreatedBy")
  transfersSent        StockTransfer[]       @relation("TransferDispatchedBy")
  transfersApproved    StockTransfer[]       @relation("TransferApprovedBy")
  transfersReceived    StockTransfer[]       @relation("TransferReceivedBy")
  transfersCancelled   StockTransfer[]       @relation("TransferCancelledBy")
  stockCounts          StockCount[]          @relation("StockCountCreatedBy")
  stockCountsSubmitted StockCount[]          @relation("StockCountSubmittedBy")
  stockCountsApplied   StockCount[]          @relation("StockCountAppliedBy")
  stockReceipts        StockReceipt[]
  phonesBlocked        BlockedPhone[]        @relation("PhoneBlockedBy")
  phonesUnblocked      BlockedPhone[]        @relation("PhoneUnblockedBy")
  refunds              Refund[]
  settingsUpdated      Setting[]
  pagesUpdated         Page[]
  storeSales           Order[]               @relation("OrderSoldBy")
  couponUses           CouponRedemption[]

  @@index([kind, isActive])
  @@index([deletedAt])
}

/// Auth.js (NextAuth v5) OAuth account link. Kept for future use; staff sign
/// in with credentials and customers with OTP.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Database sessions (not JWT), so a staff session can be revoked instantly.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  /// Useful when revoking a session from the admin UI.
  userAgent    String?
  ip           String?
  /// Last request seen on this session, for the idle timeout. Refreshed at
  /// most every few minutes, not on every request.
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@index([lastSeenAt])
}

/// Sign-in attempt counter for one throttled key (a SHA-256 of an email or an
/// IP). Incremented atomically before the password is checked, so parallel
/// requests on different server instances cannot slip past the limit.
model AuthThrottle {
  key             String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  /// End of the fixed window. Rows past it are reset on the next attempt and
  /// removed by the scheduled clean-up.
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One SMS OTP challenge. The code itself is never stored in clear text.
model OtpChallenge {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose @default(LOGIN)
  expiresAt  DateTime
  /// Failed verification attempts, for per-challenge lock-out.
  attempts   Int        @default(0)
  consumedAt DateTime?
  /// Request metadata for the per-IP rate limit.
  requestIp  String?
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

/// A named set of permission keys. The keys themselves live in code
/// (src/lib/permissions.ts, Phase 5); this table decides which role holds them.
model Role {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String?
  /// Permission keys, e.g. ["product.write", "inventory.adjust"].
  permissions  String[]
  /// True for roles the app relies on and the admin must not delete.
  isSystem     Boolean   @default(false)
  /// Grants every location without a StaffLocationAccess row.
  allLocations Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users User[]
}

/// Which locations a staff member may see and act on. Enforced in the service
/// layer, and every repository query filters on it.
model StaffLocationAccess {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([locationId])
}

/// A customer's saved address. Orders keep their own snapshot, so editing an
/// address never changes a past delivery record.
model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String?
  fullName  String
  phone     String
  line1     String
  area      String
  city      String
  postcode  String?
  zoneId    String?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// =============================================================================
// LOCATIONS & INVENTORY
// =============================================================================

/// A branch (showroom) or a warehouse. Both hold stock; only some fulfil
/// online orders.
model Location {
  id        String       @id @default(cuid())
  code      String       @unique
  type      LocationType
  nameEn    String
  nameBn    String?
  /// Street address; the administrative area is in division/district/thana.
  addressEn String?
  addressBn String?
  division  String?
  district  String?
  thana     String?
  phone     String?
  /// Opening hours, shown on the storefront.
  hoursEn   String?
  hoursBn   String?

  isActive                   Boolean @default(true)
  /// Online orders may be fulfilled from here.
  isOnlineFulfillment        Boolean @default(false)
  /// The single default location online orders reserve stock from.
  isDefaultOnlineFulfillment Boolean @default(false)
  sortOrder                  Int     @default(0)
  /// Local sample data from the seed. Shown with a "SAMPLE DATA" badge.
  isSample                   Boolean @default(false)

  /// Soft delete: a location with history is deactivated, never removed.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  inventoryLevels InventoryLevel[]
  movements       InventoryMovement[]
  transfersOut    StockTransfer[]       @relation("TransferFrom")
  transfersIn     StockTransfer[]       @relation("TransferTo")
  stockCounts     StockCount[]
  orders          Order[]
  carts           Cart[]
  staffAccess     StaffLocationAccess[]
  returnItems     ReturnItem[]
  stockReceipts   StockReceipt[]
  posSessions     PosSession[]

  @@index([type, isActive])
}

/// Stock for one variant at one location. `available` is always computed as
/// `onHand - reserved`; it is never stored.
model InventoryLevel {
  id         String @id @default(cuid())
  variantId  String
  locationId String

  onHand   Int @default(0)
  /// Held for unpaid or unshipped orders. Released on cancel or timeout.
  reserved Int @default(0)

  /// Per-variant, per-location low-stock alert threshold.
  lowStockThreshold Int?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  // A CHECK constraint keeps onHand/reserved non-negative and reserved <= onHand
  // (added by migration SQL: Prisma has no @@check attribute).

  @@unique([variantId, locationId])
  @@index([locationId])
}

/// Append-only stock ledger. Every row explains one change; rows are never
/// updated or deleted.
model InventoryMovement {
  id         String       @id @default(cuid())
  variantId  String
  locationId String
  type       MovementType
  /// Signed: negative for stock leaving, positive for stock arriving.
  quantity   Int
  /// Stable reason code (DAMAGED, LOST, FOUND, CORRECTION, OTHER, ...).
  reasonCode String?
  /// Free-text note shown in the history.
  reason     String?

  /// Stock after this movement. Null on rows written before Phase 7.
  onHandAfter    Int?
  reservedAfter  Int?
  /// Purchase cost per unit (poisha) on OPENING / PURCHASE_RECEIVE rows.
  unitCostPoisha Int?

  /// Loose reference to whatever caused the movement (order, transfer,
  /// adjustment, return). Loose on purpose: the ledger outlives its causes.
  referenceType String?
  referenceId   String?

  userId    String?
  createdAt DateTime @default(now())

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  stockCountItems StockCountItem[]

  @@index([variantId, locationId, createdAt])
  @@index([locationId, createdAt])
  @@index([type, createdAt])
  @@index([type, locationId, createdAt])
  @@index([referenceType, referenceId])
}

/// Moving stock between locations: DRAFT -> DISPATCHED -> RECEIVED.
model StockTransfer {
  id             String         @id @default(cuid())
  reference      String         @unique
  fromLocationId String
  toLocationId   String
  status         TransferStatus @default(DRAFT)
  note           String?

  createdByUserId    String?
  approvedByUserId   String?
  dispatchedByUserId String?
  receivedByUserId   String?
  cancelledByUserId  String?
  approvedAt         DateTime?
  dispatchedAt       DateTime?
  receivedAt         DateTime?
  cancelledAt        DateTime?
  cancelReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromLocation Location @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   Location @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  createdBy    User?    @relation("TransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  dispatchedBy User?    @relation("TransferDispatchedBy", fields: [dispatchedByUserId], references: [id], onDelete: SetNull)
  approvedBy   User?    @relation("TransferApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  receivedBy   User?    @relation("TransferReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  cancelledBy  User?    @relation("TransferCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  items StockTransferItem[]

  @@index([status, createdAt])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model StockTransferItem {
  id         String @id @default(cuid())
  transferId String
  variantId  String

  quantitySent      Int
  /// Null until the transfer is received. Lower or higher than quantitySent
  /// is a discrepancy, which needs a reason.
  quantityReceived  Int?
  discrepancyReason TransferDiscrepancyReason?
  note              String?

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([transferId, variantId])
  @@index([variantId])
}

/// A physical stock count at one location.
model StockCount {
  id         String           @id @default(cuid())
  reference  String           @unique
  locationId String
  /// Optional scope: variants of products in this category or its children.
  categoryId String?
  status     StockCountStatus @default(IN_PROGRESS)
  note       String?

  createdByUserId   String?
  submittedByUserId String?
  appliedByUserId   String?
  /// When the expected quantities were snapshotted.
  startedAt         DateTime?
  submittedAt       DateTime?
  /// When the corrections were applied.
  completedAt       DateTime?
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location    Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("StockCountCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  submittedBy User?     @relation("StockCountSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  appliedBy   User?     @relation("StockCountAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)

  items StockCountItem[]

  @@index([locationId, status])
}

model StockCountItem {
  id           String @id @default(cuid())
  stockCountId String
  variantId    String

  /// What the system believed at `snapshotAt`.
  systemQty              Int
  snapshotAt             DateTime  @default(now())
  /// What was actually on the shelf, and when it was last counted.
  countedQty             Int?
  countedAt              DateTime?
  /// onHand movements between snapshotAt and countedAt (sales, transfers),
  /// fixed when the count is submitted.
  movementsSinceSnapshot Int?
  /// countedQty - (systemQty + movementsSinceSnapshot): the correction.
  differenceQty          Int?

  /// The COUNT_CORRECTION movement this line produced, if any.
  movementId String?

  stockCount StockCount         @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  variant    ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  movement   InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@unique([stockCountId, variantId])
}

/// One stock receipt: goods from a supplier, or opening stock, entered by hand
/// or imported from CSV. Its lines are the InventoryMovement rows with
/// referenceType "RECEIPT" and referenceId = this id.
model StockReceipt {
  id                String             @id @default(cuid())
  reference         String             @unique
  kind              StockReceiptKind
  source            StockReceiptSource
  /// Null for a CSV import that spans several locations.
  locationId        String?
  /// Supplier challan / invoice number.
  supplierReference String?
  note              String?

  /// CSV only: the original file name and its SHA-256, to warn on re-import.
  fileName      String?
  fileHash      String?
  rowCount      Int
  totalQuantity Int

  createdByUserId String?
  createdAt       DateTime @default(now())

  location  Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([fileHash])
  @@index([createdAt])
}

/// Limits a coupon to (INCLUDE) or away from (EXCLUDE) categories/products.
/// No INCLUDE rows means "every product".
model CouponScope {
  id         String          @id @default(cuid())
  couponId   String
  mode       CouponScopeMode
  categoryId String?
  productId  String?

  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([couponId])
}

// =============================================================================
// ADDRESSES (Bangladesh administrative areas, reference data)
// =============================================================================

/// Ids are stable strings ("div-06", "dist-47", "upz-365", "dhk-metro-01")
/// so courier area mappings (Phase 11) never break.
model GeoDivision {
  id      String  @id
  nameEn  String
  nameBn  String
  bbsCode String?

  districts GeoDistrict[]
}

model GeoDistrict {
  id         String  @id
  divisionId String
  nameEn     String
  nameBn     String
  bbsCode    String?

  division GeoDivision       @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  upazilas GeoUpazila[]
  zoneArea ShippingZoneArea?

  @@index([divisionId])
}

model GeoUpazila {
  id         String      @id
  districtId String
  kind       GeoAreaKind @default(UPAZILA)
  nameEn     String
  nameBn     String
  bbsCode    String?
  isActive   Boolean     @default(true)

  district GeoDistrict       @relation(fields: [districtId], references: [id], onDelete: Restrict)
  zoneArea ShippingZoneArea?

  @@index([districtId])
}

/// Which delivery zone an upazila (or, as a fallback, a district) belongs to.
/// Lookup order: upazila -> district -> the default (fallback) zone.
model ShippingZoneArea {
  id         String  @id @default(cuid())
  zoneId     String
  districtId String? @unique
  upazilaId  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone     ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  district GeoDistrict? @relation(fields: [districtId], references: [id], onDelete: Cascade)
  upazila  GeoUpazila?  @relation(fields: [upazilaId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}

// =============================================================================
// CHECKOUT PROTECTION
// =============================================================================

/// Phone numbers that may not place orders. Unblocking keeps the row.
model BlockedPhone {
  id     String @id @default(cuid())
  /// Normalised +8801XXXXXXXXX.
  phone  String @unique
  reason String

  blockedByUserId   String?
  unblockedAt       DateTime?
  unblockedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blockedBy   User? @relation("PhoneBlockedBy", fields: [blockedByUserId], references: [id], onDelete: SetNull)
  unblockedBy User? @relation("PhoneUnblockedBy", fields: [unblockedByUserId], references: [id], onDelete: SetNull)
}

/// Refused checkout attempts, for spotting patterns. Phone and IP are stored
/// only as keyed hashes.
model CheckoutRejection {
  id        String   @id @default(cuid())
  reason    String
  phoneHash String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([reason, createdAt])
  @@index([phoneHash, createdAt])
}

// =============================================================================
// CATALOGUE
// =============================================================================

/// Category tree. One catalogue is shared by every location.
model Category {
  id              String  @id @default(cuid())
  /// One English slug serves both locales (decided 2026-11-14).
  slug            String  @unique
  /// Two to four capital letters used in product codes, e.g. "SH" -> UEH-SH0012.
  code            String? @unique
  nameEn          String
  nameBn          String?
  taglineEn       String?
  taglineBn       String?
  descriptionEn   String?
  descriptionBn   String?
  imageUrl        String?
  /// Storage key of an uploaded image; null for the static seed placeholders.
  imageStorageKey String?

  seoTitleEn       String?
  seoTitleBn       String?
  seoDescriptionEn String?
  seoDescriptionBn String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  /// Default size chart for products in this category.
  sizeChartId String?
  sizeChart   SizeChart? @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)

  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products      Product[]
  extraProducts ProductCategory[]
  stockCounts   StockCount[]
  couponScopes  CouponScope[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Brand {
  id             String  @id @default(cuid())
  slug           String  @unique
  nameEn         String
  nameBn         String?
  descriptionEn  String?
  descriptionBn  String?
  logoUrl        String?
  logoStorageKey String?
  isActive       Boolean @default(true)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
}

/// Garment measurements, attached to a product or a category.
model SizeChart {
  id      String        @id @default(cuid())
  nameEn  String
  nameBn  String?
  noteEn  String?
  noteBn  String?
  unit    SizeChartUnit @default(INCH)
  /// Column headings, e.g. [{"en":"Chest","bn":"বুক"}].
  columns Json
  /// Rows, e.g. [{"size":"M","values":["40","17.5","29"]}].
  rows    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  categories Category[]
}

model Product {
  id            String  @id @default(cuid())
  slug          String  @unique
  /// Product code used in SKUs, e.g. UEH-SH0012. Null for the Phase 4 samples.
  code          String? @unique
  nameEn        String
  nameBn        String?
  /// One-line summary used on cards and meta descriptions.
  summaryEn     String?
  summaryBn     String?
  /// Long description as an array of paragraphs.
  descriptionEn Json?
  descriptionBn Json?
  fabricEn      String?
  fabricBn      String?
  /// Care instructions as an array of lines.
  careEn        Json?
  careBn        Json?
  /// A key from the `catalog.fits` setting, e.g. "slim".
  fit           String?

  seoTitleEn       String?
  seoTitleBn       String?
  seoDescriptionEn String?
  seoDescriptionBn String?

  /// Optimistic lock: every save must name the version it started from.
  version Int @default(0)

  /// Primary category. Extra categories live in ProductCategory.
  categoryId  String
  brandId     String?
  sizeChartId String?

  status       ProductStatus @default(DRAFT)
  /// Marketing flags that drive the storefront rows.
  isNew        Boolean       @default(false)
  isBestseller Boolean       @default(false)
  isFeatured   Boolean       @default(false)

  /// Shown when a product has no reviews yet; recalculated from Review rows.
  ratingAverage Float @default(0)
  ratingCount   Int   @default(0)

  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand     Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sizeChart SizeChart? @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)

  images          ProductImage[]
  options         ProductOption[]
  variants        ProductVariant[]
  reviews         Review[]
  extraCategories ProductCategory[]
  tags            ProductTag[]
  couponScopes    CouponScope[]

  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([deletedAt])
  // Trigram indexes (pg_trgm) make ILIKE '%term%' search fast in both scripts.
  @@index([nameEn(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_nameEn_trgm_idx")
  @@index([nameBn(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_nameBn_trgm_idx")
}

/// The image with the lowest sortOrder is the product's main image.
model ProductImage {
  id              String  @id @default(cuid())
  productId       String
  url             String
  /// "cloudinary" or "local-mock"; null for static files under public/.
  storageProvider String?
  /// Provider key (Cloudinary public_id or mock file name), server-generated.
  storageKey      String?
  width           Int?
  height          Int?
  bytes           Int?
  format          String?
  altEn           String?
  altBn           String?
  sortOrder       Int     @default(0)
  /// Set when the image belongs to one colour of the product.
  optionValueId   String?

  createdAt DateTime @default(now())

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValue OptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
}

/// A dimension a product varies on (Size, Colour).
model ProductOption {
  id        String     @id @default(cuid())
  productId String
  type      OptionType
  nameEn    String
  nameBn    String?
  sortOrder Int        @default(0)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  OptionValue[]

  @@unique([productId, type])
}

model OptionValue {
  id        String  @id @default(cuid())
  optionId  String
  valueEn   String
  valueBn   String?
  /// Swatch colour for COLOUR options.
  hex       String?
  /// Short code used in SKUs, e.g. "NVY" or "L". Null for the Phase 4 samples.
  code      String?
  /// The library entry this value was copied from, if any.
  presetId  String?
  sortOrder Int     @default(0)

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  preset OptionPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)

  variantLinks ProductVariantOption[]
  images       ProductImage[]

  @@unique([optionId, valueEn])
}

/// The sellable unit: one size/colour combination, with its own SKU, barcode
/// and price. Prices are the same at every location (confirmed default); a
/// future `LocationPrice` table can override without touching this column.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  barcode   String? @unique

  pricePoisha        Int
  /// Original price, struck through on the storefront when higher.
  comparePricePoisha Int?
  /// What the business paid, for stock valuation reports. Never shown publicly.
  costPoisha         Int?

  /// Short label built from the option values, e.g. "L / White".
  labelEn String?
  labelBn String?

  weightGrams Int?
  /// Sorted option value ids joined with "+". A partial unique index (in the
  /// migration SQL) stops one product having the same combination twice.
  optionKey   String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  optionValues    ProductVariantOption[]
  inventoryLevels InventoryLevel[]
  movements       InventoryMovement[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  transferItems   StockTransferItem[]
  stockCountItems StockCountItem[]

  @@index([productId, isActive])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductVariant_sku_trgm_idx")
}

/// Join table: which option values make up a variant.
model ProductVariantOption {
  variantId     String
  optionValueId String

  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue OptionValue    @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

/// Extra categories a product is listed in, besides its primary one.
model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

/// Search and merchandising tag, with alternative spellings so "panjabi",
/// "punjabi" and "পাঞ্জাবি" all find the same products.
model Tag {
  id         String   @id @default(cuid())
  slug       String   @unique
  nameEn     String
  nameBn     String?
  /// Alternative spellings (Banglish, common misspellings), lower case.
  aliases    String[]
  /// Lower-cased names and aliases, maintained by the service; trigram-indexed.
  searchText String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductTag[]

  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Tag_searchText_trgm_idx")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

/// Library of reusable option values (sizes, colours) offered by the variant
/// matrix generator. Products copy the values they use into OptionValue.
model OptionPreset {
  id        String     @id @default(cuid())
  type      OptionType
  /// Size family ("apparel", "collar", "waist", "panjabi") or "colour".
  group     String
  /// SKU code: capital letters and digits only, e.g. "NVY", "XL", "155".
  code      String
  valueEn   String
  valueBn   String?
  hex       String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values OptionValue[]

  @@unique([type, group, code])
  @@index([type, isActive, sortOrder])
}

/// Customer product review. Moderated: nothing appears on the storefront until
/// a staff member approves it.
model Review {
  id                 String  @id @default(cuid())
  productId          String
  /// Null for a review left by a guest order.
  userId             String?
  authorName         String
  cityEn             String?
  cityBn             String?
  rating             Int
  titleEn            String?
  titleBn            String?
  bodyEn             String?
  bodyBn             String?
  isApproved         Boolean @default(false)
  /// True when the reviewer's phone matches a delivered order for this product.
  isVerifiedPurchase Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isApproved])
}

// =============================================================================
// CART
// =============================================================================

/// A cart belongs to a signed-in customer or to a guest session token. The
/// in-store till also uses carts, which is why `locationId` exists.
model Cart {
  id           String       @id @default(cuid())
  userId       String?
  sessionToken String?      @unique
  locationId   String?
  channel      SalesChannel @default(ONLINE)
  /// Applied coupon; re-validated at checkout, never trusted from here.
  couponId     String?

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  coupon   Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)

  items CartItem[]

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id              String @id @default(cuid())
  cartId          String
  variantId       String
  quantity        Int    @default(1)
  /// The price the customer last saw, only to tell them it changed.
  /// Never used for totals: prices are always read fresh.
  seenPricePoisha Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Prices are NOT stored here: the checkout recalculates from the variant.
  @@unique([cartId, variantId])
}

// =============================================================================
// ORDERS
// =============================================================================

model Order {
  id          String @id @default(cuid())
  /// Human-readable, e.g. UEH-2026-001. Generated from a Postgres sequence.
  orderNumber String @unique

  channel    SalesChannel @default(ONLINE)
  /// Which branch or warehouse fulfils (online) or sold (in store) this order.
  locationId String

  userId        String?
  /// Guest checkout keeps the contact details on the order itself.
  customerName  String
  customerPhone String
  customerEmail String?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  // --- money: every amount in poisha, all recalculated server-side --------
  subtotalPoisha Int
  discountPoisha Int @default(0)
  shippingPoisha Int @default(0)
  totalPoisha    Int
  /// Sum of completed refunds, kept here so lists do not need a join.
  refundedPoisha Int @default(0)

  couponId String?
  zoneId   String?

  // --- delivery address snapshot -----------------------------------------
  shipName     String?
  shipPhone    String?
  shipLine1    String?
  shipArea     String?
  shipCity     String?
  shipPostcode String?
  deliveryNote String?

  // --- Phase 8: guest checkout ----------------------------------------------
  /// Unguessable token for the confirmation page URL.
  publicToken      String?          @unique
  /// From the checkout form: a retried submit returns this order.
  idempotencyKey   String?          @unique
  paymentMethod    PaymentProvider?
  /// Address snapshot: ids AND names, so a later dataset change never
  /// rewrites a past order. Phase 11 maps upazila ids to courier areas.
  shipDivisionId   String?
  shipDivisionName String?
  shipDistrictId   String?
  shipDistrictName String?
  shipUpazilaId    String?
  shipUpazilaName  String?
  shipLandmark     String?
  /// Delivery zone snapshot.
  zoneCode         String?
  zoneName         String?
  couponCode       String?
  /// HMAC of the client IP (never the IP itself), for the per-IP limit.
  placedIpHash     String?
  /// Hash of the sorted variant:quantity list, for the duplicate check.
  itemsFingerprint String?
  /// Why staff should look before confirming (Phase 9), e.g. LARGE_QUANTITY.
  reviewReasons    String[]         @default([])

  /// Staff member who rang up an in-store sale.
  soldByUserId String?

  // --- Phase 9: processing ---------------------------------------------------
  /// Money actually collected (COD settled, gateway paid, till). Refunds can
  /// never exceed it (CHECK constraint).
  paidPoisha            Int           @default(0)
  /// Bumped on every change; an edit form sends the version it was opened on.
  version               Int           @default(0)
  confirmedByUserId     String?
  /// Set when enough unanswered calls were made (orders.unreachableAfterAttempts).
  unreachableAt         DateTime?
  cancelReason          CancelReason?
  cancelNote            String?
  packedAt              DateTime?
  packedByUserId        String?
  deliveryFailedAt      DateTime?
  deliveryFailedReason  String?
  returnedToWarehouseAt DateTime?
  /// The order an exchange replaces items of (this order is the replacement).
  exchangeOfOrderId     String?

  // --- Phase 9: in-store sales -----------------------------------------------
  /// The till day the sale belongs to; its bills are locked once it closes.
  posSessionId             String?
  /// Discount typed at the till (lines + bill), part of discountPoisha.
  manualDiscountPoisha     Int     @default(0)
  /// Manager who allowed a discount above the seller's limit.
  discountApprovedByUserId String?

  placedAt             DateTime  @default(now())
  confirmedAt          DateTime?
  processedAt          DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  /// When the order counts as a sale (Phase 12 reports): the first SHIPPED
  /// online (same transaction as the invoice), the moment of sale in store.
  /// Never set for cancelled orders; unchanged by a second delivery attempt.
  soldAt               DateTime?
  /// When the stock reservation for an unpaid online order expires.
  reservationExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  soldBy   User?         @relation("OrderSoldBy", fields: [soldByUserId], references: [id], onDelete: SetNull)
  coupon   Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  zone     ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  refunds        Refund[]
  shipments      Shipment[]
  returnRequests ReturnRequest[]
  exchangeFor    ReturnRequest?       @relation("ReturnExchangeOrder")
  posSession     PosSession?          @relation(fields: [posSessionId], references: [id], onDelete: Restrict)
  redemption     CouponRedemption?
  callLogs       OrderCallLog[]
  notes          OrderNote[]
  invoices       Invoice[]
  codItem        CodSettlementItem?

  @@index([status, placedAt])
  @@index([paymentStatus, placedAt])
  @@index([channel, locationId, placedAt])
  @@index([customerPhone])
  @@index([userId])
  @@index([reservationExpiresAt])
  @@index([customerPhone, status, placedAt])
  @@index([placedIpHash, placedAt])
  @@index([channel, status, placedAt])
  @@index([exchangeOfOrderId])
  @@index([posSessionId])
  @@index([soldAt])
  @@index([channel, locationId, soldAt])
}

/// A line on an order. Product name, SKU and price are snapshots: editing the
/// catalogue must never rewrite history.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  /// Kept for reporting; restricted so a sold variant cannot be hard-deleted.
  variantId String?

  productNameEn String
  productNameBn String?
  variantLabel  String?
  sku           String
  imageUrl      String?

  unitPricePoisha      Int
  quantity             Int
  lineTotalPoisha      Int
  /// Compare-at price when the line was on sale (snapshot).
  compareAtPoisha      Int?
  /// This line's share of the order discount (sums to Order.discountPoisha).
  discountPoisha       Int     @default(0)
  /// Part of discountPoisha typed at the till for this line (Phase 9).
  manualDiscountPoisha Int     @default(0)
  sizeLabelEn          String?
  sizeLabelBn          String?
  colourLabelEn        String?
  colourLabelBn        String?
  /// Weighted average purchase cost per unit when the line was sold (Phase 12
  /// snapshot, for profit reports). Null on lines sold before the snapshot.
  unitCostPoisha       Int?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  returnItems ReturnItem[]

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  /// What happened when the status itself did not change (Phase 9): EDITED,
  /// LOCATION_CHANGED, PACKED, UNPACKED, ADDRESS_CORRECTED, COD_SETTLED, ...
  event     String?
  noteEn    String?
  noteBn    String?
  /// Null when the change came from a webhook or a scheduled job.
  userId    String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// =============================================================================
// PAYMENTS
// =============================================================================

model Payment {
  id       String          @id @default(cuid())
  orderId  String
  provider PaymentProvider
  mode     IntegrationMode @default(MOCK)
  status   PaymentStatus   @default(UNPAID)

  amountPoisha          Int
  /// Gateway transaction id. Unique per provider, which is what makes the
  /// payment webhook idempotent.
  providerTransactionId String?
  /// Value id / validation id returned by the gateway.
  providerReference     String?
  paidAt                DateTime?

  /// Till: cash handed over and change given back (amountPoisha is what was kept).
  tenderedPoisha   Int?
  changePoisha     Int?
  posSessionId     String?
  recordedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts   PaymentAttempt[]
  refunds    Refund[]
  posSession PosSession?      @relation(fields: [posSessionId], references: [id], onDelete: Restrict)

  @@unique([provider, providerTransactionId])
  @@index([orderId])
  @@index([status, createdAt])
}

/// One round trip with the gateway, including the raw payloads, so a disputed
/// payment can be reconstructed.
model PaymentAttempt {
  id              String               @id @default(cuid())
  paymentId       String
  status          PaymentAttemptStatus @default(INITIATED)
  requestPayload  Json?
  responsePayload Json?
  /// Set when the IPN was verified against the provider's validation API.
  validatedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime             @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model Refund {
  id        String       @id @default(cuid())
  orderId   String
  paymentId String?
  method    RefundMethod
  status    RefundStatus @default(PENDING)

  amountPoisha Int
  /// Bank transaction id, bKash/Nagad number or gateway refund reference.
  reference    String?
  note         String?

  processedByUserId String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // --- Phase 9 ------------------------------------------------------------
  returnRequestId      String?
  /// Part of amountPoisha that refunds the delivery charge.
  shippingRefundPoisha Int       @default(0)
  requiresApproval     Boolean   @default(false)
  approvedByUserId     String?
  approvedAt           DateTime?
  rejectedReason       String?
  /// Cash refunded from a till drawer (counted in that day's Z-report).
  posSessionId         String?

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  processedBy   User?          @relation(fields: [processedByUserId], references: [id], onDelete: SetNull)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  posSession    PosSession?    @relation(fields: [posSessionId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status, createdAt])
  @@index([status, processedAt])
}

// =============================================================================
// RETURNS
// =============================================================================

model ReturnRequest {
  id        String       @id @default(cuid())
  reference String       @unique
  orderId   String
  userId    String?
  status    ReturnStatus @default(REQUESTED)

  reason      String?
  staffNote   String?
  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  rejectedAt  DateTime?
  receivedAt  DateTime?
  inspectedAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Phase 9 ------------------------------------------------------------
  type              ReturnType    @default(RETURN)
  reasonCode        ReturnReason?
  source            ReturnSource  @default(STAFF)
  /// Set when the request was accepted outside the return window (staff only).
  outsideWindowNote String?
  rejectionReason   String?
  createdByUserId   String?
  /// The replacement order of an exchange.
  exchangeOrderId   String?       @unique
  closedByUserId    String?

  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  exchangeOrder Order? @relation("ReturnExchangeOrder", fields: [exchangeOrderId], references: [id], onDelete: SetNull)

  items   ReturnItem[]
  photos  ReturnPhoto[]
  refunds Refund[]

  @@index([orderId])
  @@index([status, requestedAt])
}

/// Photo a customer or staff member attached to a return request.
model ReturnPhoto {
  id              String   @id @default(cuid())
  returnRequestId String
  provider        String
  key             String
  url             String
  createdAt       DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
}

model ReturnItem {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int

  condition        ReturnItemCondition @default(UNUSED_WITH_TAGS)
  inspectionResult InspectionResult    @default(PENDING)
  inspectionNote   String?

  /// Where accepted stock goes back in. Null for a written-off item.
  restockLocationId String?
  restockedAt       DateTime?

  /// Exchange: the variant the customer wants instead.
  exchangeVariantId String?
  /// Refund (or exchange credit) value of these units: unit price minus this
  /// line's share of the order discount, rounded so a full return adds up.
  creditPoisha      Int     @default(0)

  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  restockLocation Location?     @relation(fields: [restockLocationId], references: [id], onDelete: SetNull)

  @@index([returnRequestId])
}

// =============================================================================
// PROMOTIONS
// =============================================================================

model Coupon {
  id      String        @id @default(cuid())
  code    String        @unique
  type    CouponType
  /// Percentage (1-100) or a fixed amount in poisha, depending on `type`.
  value   Int
  channel CouponChannel @default(ONLINE)
  labelEn String?
  labelBn String?

  minSubtotalPoisha     Int?
  maxDiscountPoisha     Int?
  startsAt              DateTime?
  endsAt                DateTime?
  /// Null means unlimited.
  usageLimit            Int?
  usageLimitPerCustomer Int?
  usedCount             Int       @default(0)

  createdByUserId String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  redemptions CouponRedemption[]
  orders      Order[]
  carts       Cart[]
  scopes      CouponScope[]

  @@index([isActive, startsAt, endsAt])
}

/// One use of a coupon. Unique per order, written inside the order transaction
/// together with the `usedCount` increment.
model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  orderId        String   @unique
  userId         String?
  /// Customer phone, so a guest's usage limit can be enforced too.
  customerPhone  String?
  discountPoisha Int
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([customerPhone])
}

// =============================================================================
// SHIPPING
// =============================================================================

/// Delivery zones with their rates. Editable from the admin; every change is
/// written to the audit log.
model ShippingZone {
  id     String  @id @default(cuid())
  code   String  @unique
  nameEn String
  nameBn String?

  ratePoisha          Int
  /// Order value from which delivery is free in this zone. Null falls back to
  /// the global `shipping.freeThresholdPoisha` setting.
  freeThresholdPoisha Int?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses Address[]
  areas     ShippingZoneArea[]
}

model Shipment {
  id      String              @id @default(cuid())
  orderId String
  courier CourierProviderType @default(STEADFAST)
  /// MOCK until real courier credentials exist. Shown as a badge in the admin
  /// so a mock booking can never look real.
  mode    IntegrationMode     @default(MOCK)
  status  ShipmentStatus      @default(PENDING)

  consignmentId   String?
  trackingCode    String?
  codAmountPoisha Int     @default(0)
  /// Location the parcel was handed over from.
  fromLocationId  String?

  /// Courier name when `courier` is OTHER.
  courierName      String?
  note             String?
  failedReason     String?
  returnedAt       DateTime?
  /// Delivery charge lost on a failed delivery (what the courier still bills).
  lostChargePoisha Int       @default(0)
  createdByUserId  String?

  bookedAt    DateTime?
  deliveredAt DateTime?
  /// Raw provider response, for support and reconciliation.
  rawResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events   ShipmentEvent[]
  codItems CodSettlementItem[]

  @@unique([courier, consignmentId])
  @@index([orderId])
  @@index([status, createdAt])
}

/// One attempt to reach the customer before confirming (Phase 9).
model OrderCallLog {
  id         String      @id @default(cuid())
  orderId    String
  userId     String?
  outcome    CallOutcome
  note       String?
  /// When the customer asked to be called back.
  callbackAt DateTime?
  /// True when this attempt counts towards "unreachable": no answer or
  /// switched off, at least orders.callRetryMinHours after the last counted one.
  counted    Boolean     @default(false)
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// Staff-only note on an order. Never shown to the customer.
model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  userId    String?
  body      String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/// Staff-only note about a customer, keyed by the normalised phone number
/// (guests have no account).
model CustomerNote {
  id        String   @id @default(cuid())
  phone     String
  userId    String?
  body      String
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

/// A tax invoice. The number (INV-YYMM-NNNNN) is taken when the goods leave
/// (online: SHIPPED; in store: the sale), so a cancelled order never uses
/// one. A correction adds a version with the same number; every version is
/// kept, and `snapshot` holds exactly what was printed.
model Invoice {
  id             String   @id @default(cuid())
  number         String
  orderId        String
  version        Int      @default(1)
  isCurrent      Boolean  @default(true)
  snapshot       Json
  /// Why this version exists (null for the first one).
  reason         String?
  issuedByUserId String?
  issuedAt       DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, version])
  @@unique([number, version])
  @@index([issuedAt])
}

/// Money received from a courier for delivered cash-on-delivery orders.
model CodSettlement {
  id                  String              @id @default(cuid())
  /// COD-YYMM-NNNNN
  reference           String              @unique
  courier             CourierProviderType
  courierName         String?
  receivedOn          DateTime            @db.Date
  /// Sum of the COD amounts of the orders in it.
  expectedPoisha      Int
  /// What reached the shop's account or hand.
  receivedPoisha      Int
  /// Delivery and COD fees the courier kept.
  courierChargePoisha Int                 @default(0)
  /// (received + courier charge) - expected. Not zero means a mismatch.
  differencePoisha    Int
  courierReference    String?
  note                String?
  createdByUserId     String?
  createdAt           DateTime            @default(now())

  items CodSettlementItem[]

  @@index([receivedOn])
}

/// One order in a COD settlement. An order is settled at most once.
model CodSettlementItem {
  id             String  @id @default(cuid())
  settlementId   String
  orderId        String  @unique
  shipmentId     String?
  expectedPoisha Int
  /// What the courier paid for this order; PAID only when it equals expected.
  receivedPoisha Int

  settlement CodSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shipment   Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([settlementId])
}

/// A till day at one counter of one location: opening float, sales, cash
/// refunds, and the counted cash when it closes (Z-report). Only one open
/// day per counter (partial unique index); a closed day's bills cannot change.
model PosSession {
  id                 String           @id @default(cuid())
  /// DAY-YYMM-NNNNN
  reference          String           @unique
  locationId         String
  counterCode        String           @default("MAIN")
  status             PosSessionStatus @default(OPEN)
  openingFloatPoisha Int              @default(0)
  openedByUserId     String?
  openedAt           DateTime         @default(now())
  closedByUserId     String?
  closedAt           DateTime?
  expectedCashPoisha Int?
  countedCashPoisha  Int?
  differencePoisha   Int?
  differenceReason   String?
  /// The Z-report exactly as it was when the day closed.
  zReport            Json?

  location  Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  orders    Order[]
  payments  Payment[]
  refunds   Refund[]
  heldBills PosHeldBill[]

  @@index([locationId, openedAt])
}

/// A bill parked at the till while another customer is served. Holds no stock.
model PosHeldBill {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  label     String
  /// The cart as the till had it (lines, discounts, customer).
  cart      Json
  createdAt DateTime @default(now())

  session PosSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  note       String?
  /// "webhook", "polling" or "manual" — useful when a status is disputed.
  source     String?
  occurredAt DateTime       @default(now())
  payload    Json?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

// =============================================================================
// CONTENT
// =============================================================================

model Banner {
  id        String          @id @default(cuid())
  key       String          @unique
  placement BannerPlacement @default(HOME_HERO)
  status    ContentStatus   @default(DRAFT)

  eyebrowEn  String?
  eyebrowBn  String?
  titleEn    String
  titleBn    String?
  bodyEn     String?
  bodyBn     String?
  ctaLabelEn String?
  ctaLabelBn String?
  href       String?
  imageUrl   String?

  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, status, sortOrder])
}

/// Order and configuration of the home page sections.
model HomeSection {
  id            String          @id @default(cuid())
  type          HomeSectionType
  status        ContentStatus   @default(PUBLISHED)
  titleEn       String?
  titleBn       String?
  descriptionEn String?
  descriptionBn String?
  /// Section-specific settings, e.g. {"limit":4,"categorySlug":"denim-jeans"}.
  config        Json?
  sortOrder     Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

/// A content page (About, FAQ, policies). Draft pages are not served on the
/// storefront — the return policy stays draft until the business approves it.
model Page {
  id         String        @id @default(cuid())
  slug       String        @unique
  status     ContentStatus @default(DRAFT)
  titleEn    String
  titleBn    String?
  summaryEn  String?
  summaryBn  String?
  /// Sections as JSON: [{"heading":{...},"paragraphs":[...],"bullets":[...]}].
  sectionsEn Json?
  sectionsBn Json?

  publishedAt       DateTime?
  lastUpdatedUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastUpdatedBy User? @relation(fields: [lastUpdatedUserId], references: [id], onDelete: SetNull)

  @@index([status])
}

model MenuItem {
  id       String       @id @default(cuid())
  location MenuLocation
  labelEn  String
  labelBn  String?
  href     String
  parentId String?
  parent   MenuItem?    @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[]   @relation("MenuTree")

  isVisible Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location, isVisible, sortOrder])
}

/// Newsletter sign-ups from the storefront footer.
model NewsletterSubscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  locale      String    @default("bn")
  isActive    Boolean   @default(true)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// Messages sent from the Contact page.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  subject   String?
  message   String
  isHandled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isHandled, createdAt])
}

// =============================================================================
// SETTINGS & AUDIT
// =============================================================================

/// Typed key-value settings. Every business number the spec refuses to
/// hardcode lives here: shipping rates, free-shipping threshold, return
/// window, OTP lifetime, reservation timeout, order number format.
model Setting {
  id          String           @id @default(cuid())
  key         String           @unique
  valueType   SettingValueType @default(STRING)
  value       String
  group       String           @default("general")
  labelEn     String?
  labelBn     String?
  description String?
  /// True when a value may be read by the browser (never for secrets).
  isPublic    Boolean          @default(false)

  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([group])
}

/// Append-only audit trail for every sensitive action: price changes, stock
/// adjustments, transfers, refunds, role changes and setting changes.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  locationId String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}
